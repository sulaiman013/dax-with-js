// ============================================================================
// TrailPeak Outfitters - HOME
// The landing page of the report as a single data-only DAX measure.
// ----------------------------------------------------------------------------
// Renderer : trailpeak/trailpeak-home.js  (DOM + SVG; the projected US outline
//            is baked into the file, so runtime needs no d3, no topojson, no
//            atlas fetch and no webfont request)
// Serve    : https://cdn.statically.io/gh/sulaiman013/dax-with-js
//              @trailpeak-home-v4.0.0/trailpeak/trailpeak-home.js
//
// WHY THIS SHIPS GRAIN AND NOT TOTALS
// ----------------------------------------------------------------------------
// v1 and v2 shipped pre-aggregated rows: one per store, one per month, one per
// top product. That is enough to DRAW a dashboard and nowhere near enough to
// FILTER one. With only a store total there is nothing to re-sum when the user
// picks a region, so a click can dim things and nothing more, which is exactly
// the complaint.
//
// A native visual filters because the engine re-queries at grain. This visual
// cannot re-query at all: nothing can be written back to the model, so the
// browser must hold enough grain to answer every question the UI can ask. That
// means two fact arrays:
//
//   f  store x month   revenue, gross profit, EBITDA, operating profit,
//                      budget revenue, budget operating profit, units
//                      12 x 30 = 360 rows
//   x  product x store revenue, units, gross profit
//                      up to 120 x 12 = 1,440 rows
//
// From those two the browser can compute the KPI strip, the trend, the store
// league table, the product league table and the map bubbles for ANY subset of
// stores, regions, months or products, with no round trip.
//
// Cost is roughly 65,000 characters against a ~2,100,000 ceiling, about 3%.
// The one-page build [JS Report Page] spends 1,369,965 for comparison.
//
// RULES THIS MEASURE FOLLOWS, ALL OF THEM, WITHOUT EXCEPTION
// ----------------------------------------------------------------------------
// 1. Every text value goes through the SAME seven-step escape chain. Not five,
//    and not "the ones that looked risky". U+2028 and U+2029 terminate a
//    JavaScript string literal exactly like a newline does, and they survive a
//    copy-paste out of Word, which is where dimension text actually comes from.
// 2. Every number is an integer. Money in minor units (cents), ratios in basis
//    points, both through FORMAT(x,"0"), which emits no separator and no
//    decimal mark under any culture.
// 3. Every blank emits the token null, never 0. A zero budget is not a missing
//    budget: one is a plan of nothing, the other is no plan at all.
// 4. The closed-month filter uses KEEPFILTERS, so a slicer or report filter on
//    dim_date INTERSECTS with it instead of replacing it.
// 5. The RETURN is guarded. An empty dimension emits a message, not a payload
//    that will throw inside the renderer.
// 6. The loader retries from a second CDN silently before it ever says the word
//    "failed", and paints a loading state meanwhile.
//
// No colours, no formatted strings, no branding. The renderer owns all of it.
// ============================================================================

JS Home Page =
VAR CdnUrl =
    "https://cdn.statically.io/gh/sulaiman013/dax-with-js@trailpeak-home-v4.0.0/trailpeak/trailpeak-home.js"
VAR AltUrl =
    "https://cdn.jsdelivr.net/gh/sulaiman013/dax-with-js@trailpeak-home-v4.0.0/trailpeak/trailpeak-home.js"

// A backslash, built from its code point. A bare "\" in DAX is legal but reads
// like a typo and does not survive copy-paste through JSON-based tooling.
VAR BS = UNICHAR ( 92 )
VAR Q  = "'"
VAR LS = UNICHAR ( 8232 )   // LINE SEPARATOR
VAR PS = UNICHAR ( 8233 )   // PARAGRAPH SEPARATOR

// ---------------------------------------------------------------------------
// SCOPE
// ---------------------------------------------------------------------------
VAR _lastClosed = COALESCE ( [Last Closed Date], MAX ( dim_date[Date] ) )
VAR _monthKeys =
    CALCULATETABLE (
        VALUES ( dim_date[YearMonthKey] ),
        KEEPFILTERS ( dim_date[Date] <= _lastClosed )
    )
VAR _nMonths = COALESCE ( COUNTROWS ( _monthKeys ), 0 )
VAR _nStores = COALESCE ( COUNTROWS ( VALUES ( dim_store[StoreKey] ) ), 0 )

// ---------------------------------------------------------------------------
// DIM: STORES  [key, code, name, city, state, region, tier, sqft]
// Coordinates are NOT here. Latitude and longitude are renderer reference data,
// the same class of thing as a colour ramp, and belong in the JavaScript.
// ---------------------------------------------------------------------------
VAR _dimStore =
    CONCATENATEX (
        VALUES ( dim_store[StoreKey] ),
        VAR _sq = CALCULATE ( SELECTEDVALUE ( dim_store[SquareFeet] ) )
        RETURN
            "[" & FORMAT ( dim_store[StoreKey], "0" )
                & ",'" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                    CALCULATE ( SELECTEDVALUE ( dim_store[StoreCode] ) ),
                    BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                    "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
                & "','" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                    CALCULATE ( SELECTEDVALUE ( dim_store[StoreName] ) ),
                    BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                    "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
                & "','" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                    CALCULATE ( SELECTEDVALUE ( dim_store[City] ) ),
                    BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                    "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
                & "','" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                    CALCULATE ( SELECTEDVALUE ( dim_store[State] ) ),
                    BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                    "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
                & "','" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                    CALCULATE ( SELECTEDVALUE ( dim_store[Region] ) ),
                    BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                    "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
                & "','" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                    CALCULATE ( SELECTEDVALUE ( dim_store[StoreTier] ) ),
                    BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                    "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
                & "'," & IF ( ISBLANK ( _sq ), "null", FORMAT ( ROUND ( _sq, 0 ), "0" ) )
                & "]",
        ",", dim_store[StoreKey], ASC
    )

// ---------------------------------------------------------------------------
// DIM: MONTHS  [key, label]
// ---------------------------------------------------------------------------
VAR _dimMonth =
    CONCATENATEX (
        _monthKeys,
        "[" & FORMAT ( dim_date[YearMonthKey], "0" )
            & ",'" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                CALCULATE ( SELECTEDVALUE ( dim_date[YearMonthLabel] ) ),
                BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
            & "']",
        ",", dim_date[YearMonthKey], ASC
    )

// ---------------------------------------------------------------------------
// DIM: PRODUCTS  [key, sku, name, category]
// All of them, not a top N. The league table has to be able to re-rank under
// any store filter, and a top-8 computed at company level is the wrong eight
// the moment someone picks a region.
// ---------------------------------------------------------------------------
VAR _dimProd =
    CONCATENATEX (
        VALUES ( dim_product[ProductKey] ),
        "[" & FORMAT ( dim_product[ProductKey], "0" )
            & ",'" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                CALCULATE ( SELECTEDVALUE ( dim_product[SKU] ) ),
                BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
            & "','" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                CALCULATE ( SELECTEDVALUE ( dim_product[ProductName] ) ),
                BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
            & "','" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
                CALCULATE ( SELECTEDVALUE ( dim_product[Category] ) ),
                BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
                "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )
            & "']",
        ",", dim_product[ProductKey], ASC
    )

// ---------------------------------------------------------------------------
// FACT f: store x month
//   [storeKey, monthKey, revenue, grossProfit, ebitda, opProfit,
//    budgetRevenue, budgetOpProfit, units]                          stride 9
//
// CROSSJOIN then FILTER, because a store can legitimately have a budget row in
// a month with no actuals and the page still needs to show the gap. The filter
// drops only the combinations where BOTH sides are empty.
// ---------------------------------------------------------------------------
VAR _grain =
    FILTER (
        ADDCOLUMNS (
            CROSSJOIN ( VALUES ( dim_store[StoreKey] ), _monthKeys ),
            "@rev", CALCULATE ( [Total Revenue] ),
            "@gp",  CALCULATE ( [Gross Profit] ),
            "@eb",  CALCULATE ( [EBITDA] ),
            "@op",  CALCULATE ( [Operating Profit] ),
            "@br",  CALCULATE ( [Budget Amount], REMOVEFILTERS ( dim_account ), dim_account[Category] = "Revenue" ),
            "@bo",  CALCULATE ( [Budget (Closed)] ),
            "@un",  CALCULATE ( [Product Units] )
        ),
        NOT ( ISBLANK ( [@rev] ) && ISBLANK ( [@bo] ) )
    )

VAR _facts =
    CONCATENATEX (
        _grain,
        FORMAT ( dim_store[StoreKey], "0" ) & ","
            & FORMAT ( dim_date[YearMonthKey], "0" ) & ","
            & IF ( ISBLANK ( [@rev] ), "null", FORMAT ( ROUND ( [@rev] * 100, 0 ), "0" ) ) & ","
            & IF ( ISBLANK ( [@gp] ),  "null", FORMAT ( ROUND ( [@gp]  * 100, 0 ), "0" ) ) & ","
            & IF ( ISBLANK ( [@eb] ),  "null", FORMAT ( ROUND ( [@eb]  * 100, 0 ), "0" ) ) & ","
            & IF ( ISBLANK ( [@op] ),  "null", FORMAT ( ROUND ( [@op]  * 100, 0 ), "0" ) ) & ","
            & IF ( ISBLANK ( [@br] ),  "null", FORMAT ( ROUND ( [@br]  * 100, 0 ), "0" ) ) & ","
            & IF ( ISBLANK ( [@bo] ),  "null", FORMAT ( ROUND ( [@bo]  * 100, 0 ), "0" ) ) & ","
            & IF ( ISBLANK ( [@un] ),  "null", FORMAT ( ROUND ( [@un], 0 ),        "0" ) ),
        ","
    )

// ---------------------------------------------------------------------------
// FACT x: product x store
//   [productKey, storeKey, revenue, units, grossProfit]              stride 5
//
// SUMMARIZE over the fact, so only combinations that actually sold appear.
// No month here: the product league table follows the store filter, and adding
// month would multiply this by 30 for a view nothing currently offers.
// ---------------------------------------------------------------------------
VAR _psGrain =
    ADDCOLUMNS (
        SUMMARIZE ( fact_sales, dim_product[ProductKey], dim_store[StoreKey] ),
        "@r", CALCULATE ( SUM ( fact_sales[Revenue] ) ),
        "@u", CALCULATE ( SUM ( fact_sales[UnitsSold] ) ),
        "@c", CALCULATE ( SUM ( fact_sales[Cost] ) )
    )

VAR _psFacts =
    CONCATENATEX (
        _psGrain,
        FORMAT ( dim_product[ProductKey], "0" ) & ","
            & FORMAT ( dim_store[StoreKey], "0" ) & ","
            & IF ( ISBLANK ( [@r] ), "null", FORMAT ( ROUND ( [@r] * 100, 0 ), "0" ) ) & ","
            & IF ( ISBLANK ( [@u] ), "null", FORMAT ( ROUND ( [@u], 0 ),       "0" ) ) & ","
            & IF ( ISBLANK ( [@r] ) || ISBLANK ( [@c] ), "null",
                   FORMAT ( ROUND ( ( [@r] - [@c] ) * 100, 0 ), "0" ) ),
        ","
    )

// ---------------------------------------------------------------------------
// META
// Only what is genuinely data. The title, the strapline and the colour ramp
// live in the renderer, which is the whole argument of the technique: the
// semantic model should not be where presentation goes to hide.
// ---------------------------------------------------------------------------
VAR _esc1 =
    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE (
        COALESCE ( [Data Through Label], "" ),
        BS, BS & BS ), Q, BS & Q ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ),
        "<", BS & "u003C" ), LS, BS & "u2028" ), PS, BS & "u2029" )

VAR _firstLbl =
    CALCULATE (
        SELECTEDVALUE ( dim_date[YearMonthLabel] ),
        dim_date[YearMonthKey] = MINX ( _monthKeys, dim_date[YearMonthKey] )
    )
VAR _lastLbl =
    CALCULATE (
        SELECTEDVALUE ( dim_date[YearMonthLabel] ),
        dim_date[YearMonthKey] = MAXX ( _monthKeys, dim_date[YearMonthKey] )
    )

VAR _meta =
    "{through:'" & _esc1 & "'"
    & ",first:'" & COALESCE ( _firstLbl, "" ) & "'"
    & ",last:'"  & COALESCE ( _lastLbl, "" ) & "'"
    & ",cur:'USD',loc:'en-US'"
    & ",build:'" & FORMAT ( COALESCE ( MAXX ( _monthKeys, dim_date[YearMonthKey] ), 0 ), "0" ) & "'}"

// ---------------------------------------------------------------------------
VAR Payload =
    "window.__tpHome={meta:" & _meta
        & ",dim:{s:[" & _dimStore & "]"
             & ",m:[" & _dimMonth & "]"
             & ",p:[" & _dimProd & "]}"
        & ",f:[" & _facts & "]"
        & ",x:[" & _psFacts & "]};"

// A loader, not just a watchdog. The static tag below is the normal path. If it
// has not installed the renderer after a grace period this retries from a
// SECOND CDN with a real error event, which a static tag cannot give you. It
// never paints a failure to buy information: a retry is not evidence of
// failure, and a cold fetch through the Service is genuinely slower than one
// from Desktop. Built with DOM calls rather than innerHTML, so this string
// contains no "<" and cannot terminate the script block it lives in.
VAR Watchdog =
    "(function(){"
    & "var R=function(){return document.getElementById('tph-root');};"
    & "var up=function(){return !!(window.TPH&&window.TPH.render);};"
    & "function box(){var r=R();if(!r)return null;r.textContent='';"
    & "var d=document.createElement('div');"
    & "d.style.cssText='font:14px/1.7 Segoe UI,Arial,sans-serif;color:#5b6b7b;"
    & "padding:36px;background:#f3f4f5;position:absolute;inset:0';"
    & "r.appendChild(d);return d;}"
    & "function wait(){var d=box();if(!d)return;"
    & "var h=document.createElement('div');"
    & "h.style.cssText='font:600 12px/1 Segoe UI,sans-serif;letter-spacing:.16em;"
    & "text-transform:uppercase;color:#12683f';"
    & "h.textContent='Loading the store network';"
    & "var p=document.createElement('div');p.style.marginTop='10px';p.style.opacity='.75';"
    & "p.textContent='Fetching the renderer. The first load on a new tag can take a moment.';"
    & "d.appendChild(h);d.appendChild(p);}"
    & "function bad(t,m){var d=box();if(!d)return;"
    & "var h=document.createElement('b');h.style.color='#b3261e';h.textContent=t;"
    & "var p=document.createElement('div');p.style.marginTop='8px';p.textContent=m;"
    & "d.appendChild(h);d.appendChild(p);}"
    & "function grab(u,ok,err){var s=document.createElement('script');s.src=u;s.async=false;"
    & "s.onload=ok;s.onerror=err;(document.head||document.documentElement).appendChild(s);}"
    & "if(up()){window.TPH.render();return;}"
    & "wait();"
    & "var said=false;"
    & "function give(t,m){if(said||up())return;said=true;bad(t,m);}"
    & "setTimeout(function(){if(up())return;grab('" & AltUrl & "',function(){"
    & "setTimeout(function(){give('The renderer loaded but did not install.',"
    & "'A CDN returned the file and it executed, but window.TPH was never set. That points "
    & "at a script error inside the renderer, not at the network.');},2500);},function(){"
    & "give('The renderer could not be fetched.',"
    & "'The measure produced its payload, so the model and the DAX are fine. Neither "
    & "cdn.statically.io nor cdn.jsdelivr.net could be reached. That is egress, not the tag: "
    & "check the tenant firewall and any corporate proxy. Also confirm the visual is "
    & "HTML Content (standard) and not HTML Content (lite), which strips scripts.');});},9000);"
    & "setTimeout(function(){give('The renderer did not arrive.',"
    & "'Both CDN hosts were tried and neither finished within 30 seconds. This is almost "
    & "always a proxy holding the request open. The model and the DAX are fine.');},30000);"
    & "})();"

VAR Guard =
    "<div style='font:14px/1.7 Segoe UI,Arial,sans-serif;color:#5b6b7b;padding:36px;"
    & "background:#f3f4f5;height:100%'><b style='color:#1b1b1b'>No data in scope.</b><br>"
    & "The current filters leave no closed months or no stores, so there is nothing to plot. "
    & "Clear the filters to bring the store network back.</div>"

RETURN
    IF (
        _nMonths = 0 || _nStores = 0,
        Guard,
        "<div id='tph-root'></div>"
            & "<script>" & Payload
            & "if(window.TPH&&window.TPH.render){window.TPH.render();}"
            & Watchdog
            & "</script>"
            & "<script src='" & CdnUrl & "'></script>"
    )
