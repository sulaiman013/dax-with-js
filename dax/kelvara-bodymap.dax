) + '</b> (' + num(m.n) + ' cases)'; if (r) driver += ', and <b>' + esc(r.name.toLowerCase()) + 's</b> are the most affected role (' + num(r.n) + ').'; else driver += '.'; out.push(driver); } if (agg.lost) { out.push('<b>' + num(agg.lost) + '</b> cases put someone off work, costing <b>' + num(agg.daysAway) + '</b> days, an average of ' + dec(agg.daysAway / agg.lost, 1) + ' days per lost-time case.'); } else { out.push('No case here cost a day away from work' + (agg.daysRestricted ? ', though ' + num(agg.daysRestricted) + ' days of restricted duty were recorded.' : '.')); } var ms = agg.months; if (ms.length >= 6) { var half = Math.floor(ms.length / 2); var older = 0, newer = 0; ms.forEach(function (mm, i) { var v = agg.byMonth[mm] || 0; if (i < half) older += v; else newer += v; }); var move = pct(newer - older, older || 1); var word = Math.abs(move) < 10 ? 'broadly flat' : (move > 0 ? 'rising' : 'falling'); out.push('The trend is <b>' + word + '</b>: ' + num(newer) + ' cases in the recent half against ' + num(older) + ' in the earlier.'); } var caveat = agg.partialDenominator ? '<i>Rates divide by total exposure: hours carry no region, severity, ' + 'mechanism or role grain, so this filter narrows the cases but cannot ' + 'narrow the hours.</i>' : ''; return { title: scoped ? sel.join(' and ') : 'The period in full', lines: out, caveat: caveat }; } function clampProse(t, max) { if (t.length <= max) return t; var cut = t.slice(0, max); var stop = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('; ')); return (stop > max * 0.5 ? cut.slice(0, stop + 1) : cut.replace(/\s+\S*$/, '') + '…'); } function explainPanel(p, agg) { var n = narrate(agg, baseline(p), KV.state); var ai = window.__kvAI && window.__kvAI.key; var cached = KV.aiText && KV.aiKey === stateKey(); var lines = cached ? n.lines.slice(0, 1) : n.lines; return '<div class=""kv-panel kv-explain""><h3>What this shows' + (ai ? '<button class=""kv-ai"" data-ai=""1""' + (KV.aiBusy ? ' disabled' : '') + '>' + (KV.aiBusy ? 'Thinking…' : (cached ? 'Show the detail' : 'Ask the model')) + '</button>' : '<span class=""kv-h3n"">updates with every selection</span>') + '</h3><div class=""kv-ex""><p class=""kv-exh"">' + esc(n.title) + '</p>' + lines.map(function (l) { return '<p>' + l + '</p>'; }).join('') + (cached ? '<p class=""kv-aitext"">' + esc(clampProse(KV.aiText, 360)) + '</p>' : '') + (KV.aiErr ? '<p class=""kv-aierr"">' + esc(KV.aiErr) + '</p>' : '') + (n.caveat ? '<p>' + n.caveat + '</p>' : '') + '</div></div>'; } function group(key, label, entries, sel) { var chips = entries.map(function (e) { var on = !!sel[e[0]]; return '<button class=""kv-f' + (on ? ' on' : '') + '"" data-fk=""' + key + '"" data-fv=""' + esc(e[0]) + '"" aria-pressed=""' + on + '"">' + esc(e[1]) + '</button>'; }).join(''); return '<div class=""kv-fg""><span class=""kv-fl"">' + esc(label) + '</span>' + '<div class=""kv-fc"">' + chips + '</div></div>'; } function filterBar(p, agg) { var st = KV.state; var siteKeys = Object.keys(window.KV_SITE).map(Number).sort(function (a, b) { return (window.KV_SITE[a] || '').localeCompare(window.KV_SITE[b] || ''); }); var years = {}; for (var i = 0; i < (p.h || []).length; i += HH) years[Math.floor(p.h[i] / 100)] = true; var row1 = group('site', 'Site', siteKeys.map(function (k) { return [k, window.KV_SITE[k]]; }), st.site); var row2 = group('bu', 'Business unit', (window.KV_BU || []).map(function (b) { return [b, b]; }), st.bu) + group('shift', 'Shift', Object.keys(window.KV_SHIFT).map(function (k) { return [k, window.KV_SHIFT[k]]; }), st.shift) + group('wclass', 'Worker', Object.keys(window.KV_WCLASS).map(function (k) { return [k, window.KV_WCLASS[k]]; }), st.wclass) + group('year', 'Year', Object.keys(years).sort().map(function (y) { return [y, y]; }), st.year); var any = SETS.some(function (k) { return anyOn(st[k]); }) || st.region != null || st.sev != null; return '<div class=""kv-bar"">' + '<div class=""kv-brow"">' + row1 + '<button class=""kv-reset' + (any ? '' : ' off') + '"" data-clear=""1"">' + (any ? 'Clear all filters' : 'No filters applied') + '</button></div>' + '<div class=""kv-brow"">' + row2 + '</div></div>'; } function kpis(agg, meta) { var reportable = agg.hours > 0; var per = agg.partialDenominator ? 'per 200,000 hours, all exposure' : 'per 200,000 hours'; var cards = [ ['Cases', num(agg.cases), 'all severities'], ['Recordable', num(agg.recordable), dec(agg.cases ? (agg.recordable / agg.cases) * 100 : 0, 0) + '% of cases'], ['TRIR', reportable ? dec(agg.trir) : '—', per], ['DART rate', reportable ? dec(agg.dartRate) : '—', per], ['Days away', num(agg.daysAway), num(agg.lost) + ' lost-time cases'], ['Severity rate', reportable ? dec(agg.severityRate, 1) : '—', agg.partialDenominator ? 'days per 200,000 hours, all exposure' : 'days per 200,000 hours'] ]; return '<div class=""kv-kpis"">' + cards.map(function (c) { return '<div class=""kv-kpi""><span class=""kv-kl"">' + esc(c[0]) + '</span><strong>' + c[1] + '</strong><span class=""kv-ks"">' + esc(c[2]) + '</span></div>'; }).join('') + '</div>'; } function paint(root, p) { var agg = aggregate(p, KV.state); var meta = p.meta || {}; var chip = ''; var bits = []; if (KV.state.region != null) bits.push(regionName(KV.state.region)); if (KV.state.sev != null) bits.push((window.KV_SEV[KV.state.sev] || {}).name || ''); [['mech', window.KV_MECH], ['role', window.KV_ROLE], ['site', window.KV_SITE]] .forEach(function (pair) { Object.keys(KV.state[pair[0]] || {}).forEach(function (k) { if (KV.state[pair[0]][k]) bits.push(pair[1][k] || k); }); }); if (bits.length) { chip = '<button class=""kv-chip"" data-clear=""1"">' + esc(bits.slice(0, 3).join(' · ')) + (bits.length > 3 ? ' +' + (bits.length - 3) : '') + ' <span aria-hidden=""true"">×</span></button>'; } var sevRows = Object.keys(window.KV_SEV).map(function (k) { return { k: +k, name: window.KV_SEV[k].name, n: agg.bySev[k] || 0 }; }).filter(function (r) { return r.n > 0; }) .sort(function (a, b) { return b.n - a.n; }); var sevTotal = sumOf(agg.bySev); var sevHtml = '<div class=""kv-panel""><h3>Severity mix' + '<span class=""kv-h3n"">click to filter</span></h3>' + '<ul class=""kv-bars kv-sev"">' + (sevRows.length ? sevRows.map(function (r) { var pct = sevTotal ? (r.n / sevTotal) * 100 : 0; var on = KV.state.sev === r.k; return '<li data-sev=""' + r.k + '"" role=""button"" tabindex=""0"" aria-pressed=""' + on + '"" class=""' + (on ? 'on' : '') + '"">' + '<span class=""kv-bl"">' + esc(r.name) + '</span>' + '<span class=""kv-bt""><i style=""width:' + pct.toFixed(1) + '%;background:' + PALETTE.accent2 + '""></i></span>' + '<span class=""kv-bv"">' + num(r.n) + '<em>' + dec(pct, 0) + '%</em></span></li>'; }).join('') : '<li class=""kv-empty"">No cases.</li>') + '</ul></div>'; root.innerHTML = '<div class=""kv-head"">' + '<div><h1>' + esc(meta.title || 'Injury site surveillance') + '</h1>' + '<p>' + esc(meta.caption || '') + '</p></div>' + '<div class=""kv-head-r"">' + chip + '<span class=""kv-through"">Data through ' + esc(meta.through || '') + '</span></div>' + '</div>' + filterBar(p, agg) + kpis(agg, meta) + '<div class=""kv-body"">' + '<div class=""kv-map""><div class=""kv-maphead""><h3>Injury site</h3>' + '<span class=""kv-hint"">' + (KV.state.region != null ? 'Showing ' + esc(regionName(KV.state.region)) : 'Select a body region to filter') + '</span></div>' + figure(agg) + '<div class=""kv-legend""><span>0</span>' + [0, .2, .4, .6, .8, 1].map(function (t) { return '<i style=""background:' + ramp(t) + '""></i>'; }).join('') + '<span>' + num(agg.maxRegion) + ' cases</span></div>' + unmapped(agg) + '</div>' + '<div class=""kv-side kv-col2"">' + sevHtml + bars('Cases by site', topRows(agg.bySite, window.KV_SITE, 8), sumOf(agg.bySite), PALETTE.warn, 'site') + '</div>' + '<div class=""kv-side kv-col3"">' + bars('Top mechanisms', topRows(agg.byMech, window.KV_MECH, 8), sumOf(agg.byMech), PALETTE.accent, 'mech') + bars('Most exposed roles', topRows(agg.byRole, window.KV_ROLE, 8), sumOf(agg.byRole), PALETTE.good, 'role') + '</div>' + trend(agg) + explainPanel(p, agg) + '</div>'; } function schedule(root, p) { if (KV.frame) return; KV.frame = requestAnimationFrame(function () { KV.frame = 0; paint(root, p); }); } function stateKey() { var st = KV.state; return [st.region, st.sev].concat(SETS.map(function (k) { return k + ':' + Object.keys(st[k]).filter(function (x) { return st[k][x]; }).sort().join('|'); })).join(';'); } function aiFacts(p, agg) { var base = baseline(p); var top = function (map, lookup, n) { return topRows(map, lookup, n).map(function (r) { return { name: r[1], cases: r[2] }; }); }; return { selection: selectionLabel(KV.state), period: { months: agg.months.length, from: agg.months[0], to: agg.months[agg.months.length - 1] }, totals: { cases: agg.cases, recordable: agg.recordable, dart: agg.dart, lostTime: agg.lost, daysAway: agg.daysAway, daysRestricted: agg.daysRestricted, hoursWorked: Math.round(agg.hours) }, rates: { trir: agg.trir == null ? null : +agg.trir.toFixed(2), dartRate: agg.dartRate == null ? null : +agg.dartRate.toFixed(2), severityRate: agg.severityRate == null ? null : +agg.severityRate.toFixed(1), note: agg.partialDenominator ? 'exposure hours are not filtered by region, severity, mechanism or role' : 'numerator and denominator are filtered alike' }, unfiltered: { cases: base.cases, recordable: base.recordable, trir: base.trir == null ? null : +base.trir.toFixed(2) }, derived: { shareOfAllCasesPct: +pct(agg.cases, base.cases).toFixed(1), recordableSharePct: +pct(agg.recordable, agg.cases).toFixed(1), recordableShareUnfilteredPct: +pct(base.recordable, base.cases).toFixed(1), daysPerLostTimeCase: agg.lost ? +(agg.daysAway / agg.lost).toFixed(1) : null, hoursWorkedMillions: +(agg.hours / 1e6).toFixed(2) }, topBodyRegions: top(agg.byRegion, window.KV_REGIONS, 5), topMechanisms: top(agg.byMech, window.KV_MECH, 5), topRoles: top(agg.byRole, window.KV_ROLE, 5), bySite: top(agg.bySite, window.KV_SITE, 8), monthlyCases: agg.months.map(function (m) { return [window.KV_MONTHS[m] || m, agg.byMonth[m] || 0]; }), notLocalised: agg.unmappedTotal }; } function ungroundedNumbers(text, facts) { var hay = JSON.stringify(facts); var seen = {}; (hay.match(/\d+(?:\.\d+)?/g) || []).forEach(function (v) { seen[v] = 1; seen[Number(v).toLocaleString('en-US')] = 1; seen[String(Math.round(Number(v)))] = 1; }); var bad = []; (text.match(/\b\d[\d,]*(?:\.\d+)?\b/g) || []).forEach(function (raw) { var plain = raw.replace(/,/g, ''); if (seen[plain] || seen[raw] || seen[String(Number(plain))]) return; if (Number(plain) < 100 && plain.indexOf('.') === -1) return; if (bad.indexOf(raw) === -1) bad.push(raw); }); return bad; } var AI_SYSTEM = 'You are a safety analyst briefing an HSE manager on an occupational injury ' + 'report. You will be given the aggregate the dashboard is currently showing. ' + 'Write three or four short sentences of plain English: what stands out, what ' + 'it probably means operationally, and what to look at next. ' + 'Rules. Every figure you cite must appear verbatim in the data you are ' + 'given: do not calculate, do not round, do not convert units, do not infer ' + 'a number from another number. Percentages and averages you might want are ' + 'already supplied under ""derived"". Prefer naming things over quoting ' + 'figures; two or three numbers is plenty. If rates.note says exposure is ' + 'not filtered alike, do not compare that rate to the unfiltered one. No ' + 'bullet points, no headings, no preamble, no markdown. Keep it to two or ' + 'three sentences and under 55 words.'; function askModel(p, agg, root) { var cfg = window.__kvAI || {}; if (!cfg.key || KV.aiBusy) return; var key = stateKey(); KV.aiBusy = true; KV.aiErr = ''; schedule(root, p); var facts = aiFacts(p, agg); var ctrl = typeof AbortController === 'function' ? new AbortController() : null; var timer = setTimeout(function () { if (ctrl) ctrl.abort(); }, cfg.timeoutMs || 25000); fetch(cfg.endpoint || 'https://openrouter.ai/api/v1/chat/completions', { method: 'POST', signal: ctrl ? ctrl.signal : undefined, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + cfg.key }, body: JSON.stringify({ model: cfg.model || 'google/gemini-3.5-flash-lite', max_tokens: cfg.maxTokens || 300, temperature: 0.2, messages: [ { role: 'system', content: AI_SYSTEM }, { role: 'user', content: JSON.stringify(facts) } ] }) }).then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); }).then(function (j) { var txt = j && j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content; if (!txt) throw new Error('no text in the response'); txt = String(txt).trim(); var bad = ungroundedNumbers(txt, facts); if (bad.length) { KV.aiText = ''; KV.aiKey = ''; KV.aiErr = 'Discarded: the model cited ' + bad.join(', ') + ', which is not in the data it was given. Try again.'; return; } KV.aiText = txt; KV.aiKey = key; })['catch'](function (e) { KV.aiErr = 'The model could not be reached (' + (e && e.name === 'AbortError' ? 'timed out' : String(e.message || e)) + '). The summary above is unaffected.'; }).then(function () { clearTimeout(timer); KV.aiBusy = false; schedule(root, window.__kvBody); }); } KV.boot = function () { var root = document.getElementById('kv-root'); var p = window.__kvBody; if (!root || !p) return; if (!root.__kvWired) { root.__kvWired = true; root.addEventListener('click', function (e) { var clear = e.target.closest('[data-clear]'); if (clear) { KV.state.region = null; KV.state.sev = null; SETS.forEach(function (k) { KV.state[k] = {}; }); return schedule(root, window.__kvBody); } if (e.target.closest('[data-ai]')) { if (KV.aiText && KV.aiKey === stateKey()) { KV.aiText = ''; KV.aiKey = ''; return schedule(root, window.__kvBody); } return askModel(window.__kvBody, aggregate(window.__kvBody, KV.state), root); } var fchip = e.target.closest('[data-fk]'); if (fchip) { var fk = fchip.getAttribute('data-fk'); var fv = fchip.getAttribute('data-fv'); var kk = NUMERIC_SETS[fk] ? Number(fv) : fv; if (KV.state[fk][kk]) delete KV.state[fk][kk]; else KV.state[fk][kk] = true; return schedule(root, window.__kvBody); } var uchip = e.target.closest('[data-region-key]'); if (uchip) { var uk = +uchip.getAttribute('data-region-key'); KV.state.region = KV.state.region === uk ? null : uk; return schedule(root, window.__kvBody); } var sevLi = e.target.closest('[data-sev]'); if (sevLi) { var sk = +sevLi.getAttribute('data-sev'); KV.state.sev = KV.state.sev === sk ? null : sk; return schedule(root, window.__kvBody); } var path = e.target.closest('path[data-region]'); if (path) { var keys = window.KV_SVG_TO_KEY[path.getAttribute('data-region')] || []; var rk = keys[0]; if (rk != null) { KV.state.region = KV.state.region === rk ? null : rk; schedule(root, window.__kvBody); } } }); root.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { var b = e.target.closest('[data-fk],[data-sev]'); if (b) { e.preventDefault(); b.dispatchEvent(new MouseEvent('click', { bubbles: true })); return; } } if (e.key === 'Escape') { KV.state.region = null; KV.state.sev = null; SETS.forEach(function (k) { KV.state[k] = {}; }); schedule(root, window.__kvBody); } }); } if (KV.state.region != null) { var seen = false, f = p.f || []; for (var i = 0; i < f.length; i += 6) { if (f[i] === KV.state.region) { seen = true; break; } } if (!seen) KV.state.region = null; } paint(root, p); }; KV.boot(); })();"
VAR _css = "/* Budgeted to 1080 exactly. The visual is FitToPage on a 1920x1080 canvas, so anything that overflows is not scrolled to, it is cut off. Every band below has a fixed height and only .kv-body flexes: padding 12 x2 = 24, head 44, bar 86, kpi 92, gaps 10 x3 = 30 -> .kv-body gets 1080 - 276 = 804 The no-overflow assertion in uat/renderer.spec.js holds this honest. */ *{box-sizing:border-box;margin:0;padding:0} html,body{height:100%;overflow:hidden;background:#faf8f4;color:#2e2a24; font:14px/1.45 'Segoe UI',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased} #kv-root{height:100vh;display:flex;flex-direction:column;gap:10px;padding:12px 18px; overflow:hidden} #kv-root:focus{outline:none} .kv-bar{flex:0 0 86px;display:flex;flex-direction:column;justify-content:center;gap:7px; background:#fffdf9;border:1px solid #e8e1d4;border-radius:7px;padding:0 12px;overflow:hidden} .kv-brow{display:flex;align-items:center;gap:14px;min-width:0} .kv-fg{display:flex;align-items:center;gap:6px;min-width:0} .kv-fl{font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:#a49a89; white-space:nowrap} .kv-fc{display:flex;gap:4px;flex-wrap:nowrap} .kv-f{border:1px solid #e0d7c6;background:#f8f4ec;color:#5f574b;border-radius:999px; padding:4px 9px;font:11px 'Segoe UI',sans-serif;cursor:pointer;white-space:nowrap} .kv-f:hover{background:#f0e7d6;color:#2e2a24} .kv-f.on{background:#96641a;border-color:#96641a;color:#fff} .kv-reset{margin-left:auto;border:1px solid #e0d7c6;background:#fff;color:#7a5312; border-radius:6px;padding:6px 12px;font:600 11px 'Segoe UI',sans-serif;cursor:pointer; white-space:nowrap} .kv-reset.off{color:#b3aa9a;cursor:default} .kv-reset:not(.off):hover{background:#f7ecd8} h1{font:600 21px/1.2 Georgia,'Times New Roman',serif;letter-spacing:.1px} h3{font:600 12px/1 'Segoe UI',sans-serif;letter-spacing:.09em;text-transform:uppercase;color:#8a8071} .kv-head{flex:0 0 44px;display:flex;justify-content:space-between;align-items:flex-start; border-bottom:1px solid #e8e1d4} .kv-head p{color:#8a8071;font-size:12.5px;margin-top:3px} .kv-head-r{display:flex;align-items:center;gap:12px} .kv-through{color:#a49a89;font-size:11.5px;white-space:nowrap} .kv-chip{border:1px solid #c9a15e;background:#f7ecd8;color:#7a5312;border-radius:999px; padding:5px 12px;font:600 12px 'Segoe UI',sans-serif;cursor:pointer} .kv-chip:hover{background:#f0dfc0} .kv-kpis{flex:0 0 92px;display:grid;grid-template-columns:repeat(6,1fr);gap:10px} .kv-kpi{background:#fffdf9;border:1px solid #e8e1d4;border-radius:7px;padding:10px 14px; display:flex;flex-direction:column;gap:1px;justify-content:center} .kv-kl{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:#8a8071} .kv-kpi strong{font:600 27px/1.15 Georgia,serif;color:#2e2a24;font-variant-numeric:tabular-nums} .kv-ks{font-size:11px;color:#a49a89} /* The map spans both rows so the figure gets the full column height; the two panel stacks sit beside it and the trend runs under them. */ .kv-body{flex:1 1 auto;display:grid;grid-template-columns:768px 1fr 1fr; grid-template-rows:1fr 228px;gap:12px;min-height:0;overflow:hidden} .kv-map{grid-row:1 / 3} .kv-col2{grid-column:2;grid-row:1} .kv-col3{grid-column:3;grid-row:1} .kv-trend{grid-column:2;grid-row:2} .kv-explain{grid-column:3;grid-row:2;min-height:0;display:flex;flex-direction:column} .kv-ex{margin-top:6px;overflow:hidden;font-size:12px;line-height:1.42;color:#4a443a} .kv-ex p{margin-bottom:4px} .kv-ex b{color:#2e2a24;font-weight:600} .kv-ex i{color:#8a8071;font-style:normal;font-size:11px;display:block;margin-top:1px; padding-top:4px;border-top:1px dashed #e8e1d4} .kv-exh{font:600 12.5px Georgia,serif;color:#7a5312;margin-bottom:5px} .kv-ai{border:1px solid #c9a15e;background:#f7ecd8;color:#7a5312;border-radius:5px; padding:3px 9px;font:600 10px 'Segoe UI',sans-serif;letter-spacing:.03em;cursor:pointer; text-transform:none} .kv-ai:disabled{opacity:.55;cursor:default} .kv-ai:hover:not(:disabled){background:#f0dfc0} .kv-aitext{margin-top:7px;padding-top:6px;border-top:1px dashed #e8e1d4;color:#5a5247} .kv-aierr{margin-top:6px;color:#a06a30;font-size:11.5px} .kv-map,.kv-panel{background:#fffdf9;border:1px solid #e8e1d4;border-radius:7px;padding:11px 14px} .kv-map{display:flex;flex-direction:column;min-height:0} .kv-maphead{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px} .kv-hint{font-size:11.5px;color:#a49a89} #kv-figure{flex:1 1 auto;width:100%;min-height:0} #kv-figure path[data-region]{cursor:pointer;transition:opacity .12s} #kv-figure path[data-region]:hover{opacity:.6} .kv-cap{text-anchor:middle;font:11px Georgia,serif;fill:#a49a89;letter-spacing:.22em} .kv-legend{display:flex;align-items:center;gap:3px;font-size:10.5px;color:#a49a89;padding-top:5px} .kv-legend i{width:26px;height:8px;border-radius:2px;display:inline-block} .kv-unmapped{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding-top:7px; margin-top:6px;border-top:1px dashed #e8e1d4} .kv-ul{font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:#8a8071; margin-right:2px} .kv-uchip{border:1px solid #e0d7c6;background:#f8f4ec;color:#6b6155;border-radius:999px; padding:3px 10px;font:11px 'Segoe UI',sans-serif;cursor:pointer} .kv-uchip b{color:#2e2a24;margin-left:3px} .kv-uchip:hover{background:#f0e7d6} .kv-uchip.on{background:#f7ecd8;border-color:#d8b77c;color:#7a5312} .kv-side{display:flex;flex-direction:column;gap:12px;min-height:0;overflow:hidden} .kv-side .kv-panel{flex:1;min-height:0;display:flex;flex-direction:column} /* Severity has at most six rows, so it sizes to content; the two long lists take the space it would otherwise have left empty. */ .kv-bars{list-style:none;margin-top:8px;display:flex;flex-direction:column;gap:5px; flex:1;justify-content:flex-start;overflow:hidden} .kv-bars li{display:grid;grid-template-columns:142px 1fr 62px;align-items:center;gap:8px; font-size:11.5px;border-radius:4px;padding:1px 3px} .kv-sev li,.kv-click li{cursor:pointer} .kv-sev li:hover,.kv-click li:hover{background:#f6f1e7} .kv-sev li.on,.kv-click li.on{background:#f7ecd8;box-shadow:inset 0 0 0 1px #d8b77c} .kv-sev li:focus-visible,.kv-click li:focus-visible{outline:2px solid #96641a;outline-offset:1px} h3{display:flex;align-items:baseline;justify-content:space-between;gap:8px} .kv-h3n{font:400 9.5px 'Segoe UI',sans-serif;letter-spacing:.04em;text-transform:none; color:#bdb3a2} .kv-bl{color:#4a443a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .kv-bt{background:#f1ece2;border-radius:3px;height:11px;overflow:hidden} .kv-bt i{display:block;height:100%;border-radius:3px;min-width:2px} .kv-bv{text-align:right;font-variant-numeric:tabular-nums;color:#2e2a24;font-weight:600} .kv-bv em{font-style:normal;font-weight:400;color:#a49a89;margin-left:5px;font-size:10.5px} .kv-empty{color:#a49a89;font-size:11.5px;padding:6px 0} .kv-trend{min-height:0;display:flex;flex-direction:column} .kv-trend svg{width:100%;flex:1 1 auto;min-height:0;margin-top:2px;display:block} .kv-tick{font:9.5px 'Segoe UI',sans-serif;fill:#a49a89;text-anchor:middle}"
RETURN
    IF (
        ISBLANK ( _f ),
        "<style>" & _css & "</style><div id=""kv-root""><div class=""kv-head"">"
            & "<div><h1>Injury site surveillance</h1>"
            & "<p>No cases match the current filters.</p></div></div></div>",
        "<style>" & _css & "</style>"
            & "<div id=""kv-root"" tabindex=""0""></div>"
            & "<script>" & _payload & _runtime & "</script>"
    )
