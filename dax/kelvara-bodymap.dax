JS Body Map =
// ---------------------------------------------------------------
// caption: the only string that crosses from the model to the page
// ---------------------------------------------------------------
VAR _siteCount = COUNTROWS ( VALUES ( dim_site[SiteName] ) )
VAR _siteAll = COUNTROWS ( ALLNOBLANKROW ( dim_site[SiteName] ) )
VAR _siteText =
    IF (
        _siteCount = _siteAll,
        "All sites",
        CONCATENATEX ( VALUES ( dim_site[SiteName] ), dim_site[SiteName], ", ", dim_site[SiteName], ASC )
    )
VAR _from = MIN ( dim_date[Date] )
VAR _to = MAX ( dim_date[Date] )
VAR _rawCaption =
    _siteText & "  |  " & FORMAT ( _from, "MMM yyyy" ) & " to " & FORMAT ( _to, "MMM yyyy" )

// Seven steps, and the order is the whole point. Backslash must go
// first or every escape written after it gets escaped a second time.
VAR _s1 = SUBSTITUTE ( _rawCaption, "\", "\\" )
VAR _s2 = SUBSTITUTE ( _s1, "'", "\'" )
VAR _s3 = SUBSTITUTE ( _s2, UNICHAR ( 13 ), "\r" )
VAR _s4 = SUBSTITUTE ( _s3, UNICHAR ( 10 ), "\n" )
VAR _s5 = SUBSTITUTE ( _s4, "<", "\u003C" )
VAR _s6 = SUBSTITUTE ( _s5, UNICHAR ( 8232 ), "\u2028" )
VAR _caption = SUBSTITUTE ( _s6, UNICHAR ( 8233 ), "\u2029" )
VAR _through = FORMAT ( CALCULATE ( MAX ( fact_incident[Date] ) ), "d MMM yyyy" )

// ---------------------------------------------------------------
// grain. The page IS the visual, so nothing here can cross-filter
// out to a neighbour: the filter bar is drawn by this same measure
// and slices in the browser. That only works if the browser holds
// facts rather than aggregates, so the incident stream ships at row
// grain, carrying every key the filter bar exposes.
//
// 1,492 rows x 8 integers is about 45KB. Aggregating first would be
// smaller but would fix the filter set at build time, which is the
// thing being avoided.
//
// FORMAT ( x, "0" ) throughout: it is the locale-safe way to emit an
// integer. Without it a de-DE or fr-FR workspace turns 1234.5 into
// "1234,5" and silently corrupts the array into unparseable JS.
// ---------------------------------------------------------------
VAR _f =
    CONCATENATEX (
        SUMMARIZE (
            fact_incident,
            fact_incident[IncidentKey],
            fact_incident[BodyRegionKey],
            fact_incident[SeverityKey],
            fact_incident[SiteKey],
            fact_incident[ShiftKey],
            fact_incident[WorkerClassKey],
            fact_incident[MechanismKey],
            fact_incident[JobRoleKey],
            fact_incident[DaysAway],
            fact_incident[DaysRestricted],
            dim_date[YearMonthKey]
        ),
        FORMAT ( fact_incident[BodyRegionKey], "0" ) & ","
            & FORMAT ( fact_incident[SeverityKey], "0" ) & ","
            & FORMAT ( dim_date[YearMonthKey], "0" ) & ","
            & FORMAT ( fact_incident[SiteKey], "0" ) & ","
            & FORMAT ( fact_incident[ShiftKey], "0" ) & ","
            & FORMAT ( fact_incident[WorkerClassKey], "0" ) & ","
            & FORMAT ( fact_incident[MechanismKey], "0" ) & ","
            & FORMAT ( fact_incident[JobRoleKey], "0" ) & ","
            & FORMAT ( fact_incident[DaysAway] + 0, "0" ) & ","
            & FORMAT ( fact_incident[DaysRestricted] + 0, "0" ),
        ","
    )

// Exposure carries the same slicing keys, so a filtered TRIR gets a
// denominator filtered the same way. Region is deliberately absent:
// hours are exposure, not injury, so selecting a body region must
// never shrink the denominator.
VAR _h =
    CONCATENATEX (
        ADDCOLUMNS (
            SUMMARIZE (
                fact_exposure_hours,
                dim_date[YearMonthKey],
                fact_exposure_hours[SiteKey],
                fact_exposure_hours[ShiftKey],
                fact_exposure_hours[WorkerClassKey]
            ),
            "@hh", CALCULATE ( SUM ( fact_exposure_hours[HoursWorked] ) )
        ),
        FORMAT ( dim_date[YearMonthKey], "0" ) & ","
            & FORMAT ( fact_exposure_hours[SiteKey], "0" ) & ","
            & FORMAT ( fact_exposure_hours[ShiftKey], "0" ) & ","
            & FORMAT ( fact_exposure_hours[WorkerClassKey], "0" ) & ","
            & FORMAT ( ROUND ( [@hh] + 0, 0 ), "0" ),
        ","
    )

// ---------------------------------------------------------------
// payload then runtime, in that order: the runtime boots on its
// last line and needs window.__kvBody to already exist.
// ---------------------------------------------------------------
VAR _payload =
    "window.__kvBody={meta:{title:'Injury site surveillance',caption:'"
        & _caption & "',through:'" & _through & "',minCases:"
        & FORMAT ( [Min Case Threshold] + 0, "0" ) & "},f:["
        & _f & "],h:[" & _h & "]};"
VAR _runtime = "var BODY_VIEWBOX = '0 0 720 692'; var BODY_FRONT_CX = 170, BODY_BACK_CX = 540; var BODY_SHAPES = {""front.skull"":[{""d"":""M170 11 C187 11 200 26 200 44 C200 58 195 68 188 74 L152 74 C145 68 140 58 140 44 C140 26 153 11 170 11 Z"",""tf"":""""}],""back.skull"":[{""d"":""M540 10 C557 10 570 26 570 48 C570 74 557 98 540 98 C523 98 510 74 510 48 C510 26 523 10 540 10 Z"",""tf"":""""}],""front.jaw"":[{""d"":""M152 62 L188 62 C186 80 179 94 170 94 C161 94 154 80 152 62 Z"",""tf"":""""}],""front.neck"":[{""d"":""M158 92 L182 92 L184 112 L156 112 Z"",""tf"":""""},{""d"":""M184 112 C200 114 214 120 226 128 L220 142 C206 134 192 128 180 126 Z"",""tf"":""""},{""d"":""M184 112 C200 114 214 120 226 128 L220 142 C206 134 192 128 180 126 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.neck"":[{""d"":""M526 96 L554 96 L556 114 C574 118 590 126 602 136 L594 150 C578 142 564 136 554 134 L540 186 L526 134 C516 136 502 142 486 150 L478 136 C490 126 506 118 524 114 Z"",""tf"":""""}],""front.shoulder"":[{""d"":""M196 116 C214 118 230 128 236 146 C240 164 234 180 222 186 C210 178 200 160 194 138 C192 128 193 120 196 116 Z"",""tf"":""""},{""d"":""M196 116 C214 118 230 128 236 146 C240 164 234 180 222 186 C210 178 200 160 194 138 C192 128 193 120 196 116 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.shoulder"":[{""d"":""M566 116 C584 118 600 128 606 146 C610 164 604 180 592 186 C580 178 570 160 564 138 C562 128 563 120 566 116 Z"",""tf"":""""},{""d"":""M566 116 C584 118 600 128 606 146 C610 164 604 180 592 186 C580 178 570 160 564 138 C562 128 563 120 566 116 Z"",""tf"":""translate(1080,0) scale(-1,1)""}],""front.chest"":[{""d"":""M146 174 L194 174 C198 190 198 206 194 220 L146 220 C142 206 142 190 146 174 Z"",""tf"":""""},{""d"":""M170 114 C188 116 204 124 212 138 C214 156 204 168 188 172 C176 172 170 168 170 158 Z"",""tf"":""""},{""d"":""M170 114 C188 116 204 124 212 138 C214 156 204 168 188 172 C176 172 170 168 170 158 Z"",""tf"":""translate(340,0) scale(-1,1)""},{""d"":""M196 176 C204 184 210 200 212 220 C212 242 208 260 202 274 L194 274 C198 244 198 206 196 176 Z"",""tf"":""""},{""d"":""M196 176 C204 184 210 200 212 220 C212 242 208 260 202 274 L194 274 C198 244 198 206 196 176 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""front.abdomen"":[{""d"":""M148 222 L192 222 C196 240 196 262 192 276 L148 276 C144 262 144 240 148 222 Z"",""tf"":""""}],""front.pelvis"":[{""d"":""M172 278 L206 276 C214 290 218 310 214 326 L172 326 Z"",""tf"":""""},{""d"":""M172 278 L206 276 C214 290 218 310 214 326 L172 326 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.upperback"":[{""d"":""M170 136 C188 138 204 146 214 160 C218 182 212 206 202 220 L170 220 Z"",""tf"":""translate(370,0)""},{""d"":""M170 136 C188 138 204 146 214 160 C218 182 212 206 202 220 L170 220 Z"",""tf"":""translate(370,0) translate(340,0) scale(-1,1)""}],""back.lowerback"":[{""d"":""M518 222 L562 222 C568 244 568 268 564 284 L516 284 C512 268 512 244 518 222 Z"",""tf"":""""}],""back.buttock"":[{""d"":""M172 286 L208 284 C216 300 220 320 214 336 L172 336 Z"",""tf"":""translate(370,0)""},{""d"":""M172 286 L208 284 C216 300 220 320 214 336 L172 336 Z"",""tf"":""translate(370,0) translate(340,0) scale(-1,1)""}],""front.upperarm"":[{""d"":""M212 146 L236 150 C240 170 242 190 242 206 L218 210 C214 190 212 168 212 146 Z"",""tf"":""""},{""d"":""M212 146 L236 150 C240 170 242 190 242 206 L218 210 C214 190 212 168 212 146 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.upperarm"":[{""d"":""M212 146 L236 150 C240 170 242 190 242 206 L218 210 C214 190 212 168 212 146 Z"",""tf"":""translate(370,0)""},{""d"":""M212 146 L236 150 C240 170 242 190 242 206 L218 210 C214 190 212 168 212 146 Z"",""tf"":""translate(370,0) translate(340,0) scale(-1,1)""}],""front.elbow"":[{""d"":""M218 212 L242 208 C246 220 248 230 248 240 L222 244 Z"",""tf"":""""},{""d"":""M218 212 L242 208 C246 220 248 230 248 240 L222 244 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.elbow"":[{""d"":""M218 212 L242 208 C246 220 248 230 248 240 L222 244 Z"",""tf"":""translate(370,0)""},{""d"":""M218 212 L242 208 C246 220 248 230 248 240 L222 244 Z"",""tf"":""translate(370,0) translate(340,0) scale(-1,1)""}],""front.forearm"":[{""d"":""M222 246 L248 242 C252 262 256 282 256 300 L232 306 C228 286 224 266 222 246 Z"",""tf"":""""},{""d"":""M222 246 L248 242 C252 262 256 282 256 300 L232 306 C228 286 224 266 222 246 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.forearm"":[{""d"":""M222 246 L248 242 C252 262 256 282 256 300 L232 306 C228 286 224 266 222 246 Z"",""tf"":""translate(370,0)""},{""d"":""M222 246 L248 242 C252 262 256 282 256 300 L232 306 C228 286 224 266 222 246 Z"",""tf"":""translate(370,0) translate(340,0) scale(-1,1)""}],""front.wrist"":[{""d"":""M232 308 L256 302 C258 310 259 318 258 324 L234 330 Z"",""tf"":""""},{""d"":""M232 308 L256 302 C258 310 259 318 258 324 L234 330 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.wrist"":[{""d"":""M232 308 L256 302 C258 310 259 318 258 324 L234 330 Z"",""tf"":""translate(370,0)""},{""d"":""M232 308 L256 302 C258 310 259 318 258 324 L234 330 Z"",""tf"":""translate(370,0) translate(340,0) scale(-1,1)""}],""front.hand"":[{""d"":""M234 332 L258 326 C270 336 278 352 274 364 C268 372 254 370 244 362 C236 354 232 342 234 332 Z"",""tf"":""""},{""d"":""M234 332 L258 326 C270 336 278 352 274 364 C268 372 254 370 244 362 C236 354 232 342 234 332 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.hand"":[{""d"":""M234 332 L258 326 C270 336 278 352 274 364 C268 372 254 370 244 362 C236 354 232 342 234 332 Z"",""tf"":""translate(370,0)""},{""d"":""M234 332 L258 326 C270 336 278 352 274 364 C268 372 254 370 244 362 C236 354 232 342 234 332 Z"",""tf"":""translate(370,0) translate(340,0) scale(-1,1)""}],""front.thigh"":[{""d"":""M174 328 L212 328 C218 350 219 382 210 412 C207 424 206 430 206 434 L180 434 C177 410 174 372 174 328 Z"",""tf"":""""},{""d"":""M174 328 L212 328 C218 350 219 382 210 412 C207 424 206 430 206 434 L180 434 C177 410 174 372 174 328 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.thigh"":[{""d"":""M544 338 L582 338 C588 360 589 396 580 420 C577 430 576 434 576 436 L550 436 C547 412 544 376 544 338 Z"",""tf"":""""},{""d"":""M544 338 L582 338 C588 360 589 396 580 420 C577 430 576 434 576 436 L550 436 C547 412 544 376 544 338 Z"",""tf"":""translate(1080,0) scale(-1,1)""}],""front.knee"":[{""d"":""M180 436 L206 436 C208 452 208 466 206 478 L181 478 Z"",""tf"":""""},{""d"":""M180 436 L206 436 C208 452 208 466 206 478 L181 478 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.knee"":[{""d"":""M550 438 L576 438 C578 454 578 466 576 478 L551 478 Z"",""tf"":""""},{""d"":""M550 438 L576 438 C578 454 578 466 576 478 L551 478 Z"",""tf"":""translate(1080,0) scale(-1,1)""}],""front.lowerleg"":[{""d"":""M181 480 L206 480 C209 508 205 546 201 572 L184 572 C180 546 178 508 181 480 Z"",""tf"":""""},{""d"":""M181 480 L206 480 C209 508 205 546 201 572 L184 572 C180 546 178 508 181 480 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.lowerleg"":[{""d"":""M551 480 C560 480 572 482 578 486 C584 510 581 546 574 574 L554 574 C548 546 546 508 551 480 Z"",""tf"":""""},{""d"":""M551 480 C560 480 572 482 578 486 C584 510 581 546 574 574 L554 574 C548 546 546 508 551 480 Z"",""tf"":""translate(1080,0) scale(-1,1)""}],""front.ankle"":[{""d"":""M184 574 L201 574 C202 584 202 590 201 595 L185 595 Z"",""tf"":""""},{""d"":""M184 574 L201 574 C202 584 202 590 201 595 L185 595 Z"",""tf"":""translate(340,0) scale(-1,1)""}],""back.ankle"":[{""d"":""M554 576 L574 576 C574 592 572 606 570 616 L556 616 C554 606 554 592 554 576 Z"",""tf"":""""},{""d"":""M554 576 L574 576 C574 592 572 606 570 616 L556 616 C554 606 554 592 554 576 Z"",""tf"":""translate(1080,0) scale(-1,1)""}],""front.foot"":[{""d"":""M185 597 L201 597 C203 611 209 623 215 631 C219 639 215 647 205 647 L186 643 C182 627 183 611 185 597 Z"",""tf"":""""},{""d"":""M185 597 L201 597 C203 611 209 623 215 631 C219 639 215 647 205 6